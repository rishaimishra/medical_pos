// Prisma Schema for Medical POS & Pharmacy Management System
// Clean Domain-Driven Relational Schema (22 Models, 49 Indexes)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. STORE SETTINGS & CONFIGURATION
// ============================================================================

// Table: settings (Pharmacy Store Tenant Master: profile, licensing, tax defaults, and SMTP settings)
model Settings {
  id                   Int       @id @default(autoincrement())
  storeName            String    @default("") @map("store_name") @db.VarChar(255)
  storeAddress         String?   @map("store_address") @db.Text
  storePhone           String?   @map("store_phone") @db.VarChar(50)
  storeEmail           String?   @map("store_email") @db.VarChar(255)
  storeGst             String?   @map("store_gst") @db.VarChar(50)
  storeDl              String?   @map("store_dl") @db.VarChar(50)
  currency             String    @default("₹") @db.VarChar(20)
  lowQty               Int       @default(10) @map("low_qty")
  expiryDays           Int       @default(90) @map("expiry_days")
  emailProvider        String    @default("sendgrid") @map("email_provider") @db.VarChar(20) // "sendgrid" | "smtp"
  sendgridKey          String?   @map("sendgrid_key") @db.VarChar(255)
  smtpHost             String?   @map("smtp_host") @db.VarChar(255)
  smtpPort             Int       @default(587) @map("smtp_port")
  smtpUser             String?   @map("smtp_user") @db.VarChar(255)
  smtpPass             String?   @map("smtp_pass") @db.VarChar(255)
  smtpFrom             String?   @map("smtp_from") @db.VarChar(255)
  smtpName             String?   @map("smtp_name") @db.VarChar(255)
  smtpSecure           String    @default("tls") @map("smtp_secure") @db.VarChar(10)
  setupDone            Boolean   @default(false) @map("setup_done")
  setupStep            Int       @default(1) @map("setup_step")
  setupToken           String?   @map("setup_token") @db.VarChar(100)
  setupOtp             String?   @map("setup_otp") @db.VarChar(10)
  setupOtpExp          DateTime? @map("setup_otp_exp")
  storage              String    @default("postgres") @db.VarChar(20)
  lastStockAlertSentAt DateTime? @map("last_stock_alert_sent_at")
  storeStatus          String    @default("active") @map("store_status") @db.VarChar(30) // active, trialing, grace_period, suspended, archived
  suspensionReason     String?   @map("suspension_reason") @db.Text
  suspendedAt          DateTime? @map("suspended_at")
  ownerName            String?   @map("owner_name") @db.VarChar(255)
  ownerEmail           String?   @map("owner_email") @db.VarChar(255)
  city                 String?   @db.VarChar(100)
  state                String?   @db.VarChar(100)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  branches             Branch[]
  users                User[]
  medicines            Medicine[]
  suppliers            Supplier[]
  customers            Customer[]
  supplierMessages     SupplierMessage[]
  patientMessages      PatientMessage[]
  auditLogs            AuditLog[]
  discounts            Discount[]
  expenses             Expense[]
  cashDrawerClosings   CashDrawerClosing[]
  subscriptions        StoreSubscription[]
  subscriptionPayments SubscriptionPayment[]

  @@index([storeStatus], name: "idx_settings_store_status")
  @@map("settings")
}

// Table: branches (Multi-outlet stores and pharmacy branches per Store Tenant)
model Branch {
  id        Int      @id @default(autoincrement())
  storeId   Int?     @map("store_id") // Parent Pharmacy Store Tenant (Settings.id)
  code      String   @db.VarChar(20) // e.g. MAIN, BR-02 (Unique within each Store Tenant)
  name      String   @db.VarChar(255)
  tagline   String?  @db.VarChar(255)
  address   String?  @db.Text
  phone     String?  @db.VarChar(50)
  email     String?  @map("email") @db.VarChar(255)
  gstNo     String?  @map("gst_no") @db.VarChar(50)
  dlNo      String?  @map("dl_no") @db.VarChar(50)
  isMain    Boolean  @default(false) @map("is_main")
  active    Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  store            Settings?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  users            User[]
  batches          Batch[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  sales            Sale[]
  returns          Return[]
  stockAdjustments StockAdjustment[]
  customerPayments   CustomerPayment[]
  auditLogs          AuditLog[]
  expenses           Expense[]
  cashDrawerClosings CashDrawerClosing[]
  patientMessages    PatientMessage[]

  @@unique([storeId, code], name: "uk_store_branch_code")
  @@index([storeId], name: "idx_branches_store")
  @@index([code], name: "idx_branches_code")
  @@index([isMain], name: "idx_branches_is_main")
  @@map("branches")
}

// ============================================================================
// 2. USER ACCOUNTS & ROLE-BASED ACCESS CONTROL (RBAC)
// ============================================================================

// Table: users (Staff, Pharmacist, Cashier, Admin accounts scoped to Store Tenant)
model User {
  id          Int       @id @default(autoincrement())
  storeId     Int?      @map("store_id") // Parent Pharmacy Store Tenant (Settings.id)
  name        String    @db.VarChar(255)
  username    String    @unique @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        String    @default("staff") @db.VarChar(50) // admin, staff, cashier, accountant
  permissions String?   @db.Text
  branchId    Int?      @map("branch_id") // NULL = All-Branch Access within storeId; Int = Assigned Branch
  active      Boolean   @default(true)
  lastLogin   DateTime? @map("last_login")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  store                 Settings?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch                Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salesCreated          Sale[]
  purchaseOrdersCreated PurchaseOrder[]   @relation("POCreator")
  supplierPayments      SupplierPayment[]
  customerPayments      CustomerPayment[] @relation("CustomerPaymentCreator")
  stockAdjustments      StockAdjustment[]
  patientMessagesOut    PatientMessage[]
  auditLogs             AuditLog[]
  expenses              Expense[]
  cashDrawerClosings    CashDrawerClosing[]

  @@index([storeId], name: "idx_users_store")
  @@index([role], name: "idx_users_role")
  @@index([active], name: "idx_users_active")
  @@index([branchId], name: "idx_users_branch")
  @@map("users")
}

// ============================================================================
// 3. MEDICINE MASTER CATALOG & MULTI-BATCH INVENTORY
// ============================================================================

// Table: medicines (Master drug catalog, composition, schedule type, and rack locations)
model Medicine {
  id             Int      @id @default(autoincrement())
  storeId        Int?     @map("store_id")
  name           String   @db.VarChar(255)
  genericName    String?  @map("generic_name") @db.VarChar(255)
  company        String   @db.VarChar(255)
  category       String   @db.VarChar(100)
  customCategory String?  @map("custom_category") @db.VarChar(100)
  hsnCode        String?  @map("hsn_code") @db.VarChar(50)
  gstPercent     Decimal  @default(12.00) @map("gst_percent") @db.Decimal(5, 2)
  description    String?  @db.Text
  rackLocation   String?  @map("rack_location") @db.VarChar(100)
  scheduleType   String   @default("normal") @map("schedule_type") @db.VarChar(20) // normal, schedule_h, schedule_h1
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  store            Settings?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batches          Batch[]
  saleItems        SaleItem[]
  poItems          POItem[]
  returnItems      ReturnItem[]
  stockAdjustments StockAdjustment[]

  @@index([storeId], name: "idx_medicines_store")
  @@index([name], name: "idx_medicines_name")
  @@index([genericName], name: "idx_medicines_generic")
  @@index([company], name: "idx_medicines_company")
  @@index([category], name: "idx_medicines_category")
  @@index([scheduleType], name: "idx_medicines_schedule")
  @@map("medicines")
}

// Table: categories (Dosage forms: Tablet, Syrup, Injection, etc.)
model Category {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  type String @default("dosage") @db.VarChar(50) // dosage or custom

  @@map("categories")
}

// Table: batches (Individual manufactured batch records with FEFO expiry and MRP)
model Batch {
  id            Int       @id @default(autoincrement())
  medicineId    Int       @map("medicine_id")
  batchNo       String    @map("batch_no") @db.VarChar(100)
  mfgDate       DateTime? @map("mfg_date") @db.Date
  expiryDate    DateTime  @map("expiry_date") @db.Date
  quantity      Int       @default(0)
  purchasePrice Decimal   @default(0.00) @map("purchase_price") @db.Decimal(10, 2)
  mrp           Decimal   @map("mrp") @db.Decimal(10, 2)
  supplierId    Int?      @map("supplier_id")
  branchId      Int?      @map("branch_id")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  stockAdjustments StockAdjustment[]

  @@unique([medicineId, batchNo, branchId], name: "uk_medicine_batch_branch")
  @@index([medicineId], name: "idx_batches_medicine")
  @@index([expiryDate], name: "idx_batches_expiry")
  @@index([batchNo], name: "idx_batches_batch_no")
  @@index([branchId], name: "idx_batches_branch")
  @@map("batches")
}

// ============================================================================
// 4. SUPPLIERS & PROCUREMENT
// ============================================================================

// Table: suppliers (Vendor & distributor directory)
model Supplier {
  id           Int      @id @default(autoincrement())
  storeId      Int?     @map("store_id")
  name         String   @db.VarChar(255)
  contact      String?  @db.VarChar(255)
  phone        String   @db.VarChar(50)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text
  gstNo        String?  @map("gst_no") @db.VarChar(50)
  dlNo         String?  @map("dl_no") @db.VarChar(50)
  paymentTerms Int      @default(30) @map("payment_terms") // Credit period in days
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  store            Settings?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batches          Batch[]
  purchaseOrders   PurchaseOrder[]
  payments         SupplierPayment[]
  supplierUsers    SupplierUser[]
  supplierMessages SupplierMessage[]

  @@index([storeId], name: "idx_suppliers_store")
  @@index([name], name: "idx_suppliers_name")
  @@index([phone], name: "idx_suppliers_phone")
  @@map("suppliers")
}

// Table: supplier_users (Supplier portal credentials)
model SupplierUser {
  id         Int       @id @default(autoincrement())
  supplierId Int       @map("supplier_id")
  name       String    @db.VarChar(255)
  username   String    @unique @db.VarChar(100)
  email      String    @unique @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  password   String    @db.VarChar(255)
  active     Boolean   @default(true)
  verified   Boolean   @default(false)
  lastLogin  DateTime? @map("last_login")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId], name: "idx_supplier_users_supplier")
  @@map("supplier_users")
}

// Table: supplier_payments (Accounts payable vendor payments)
model SupplierPayment {
  id            Int      @id @default(autoincrement())
  supplierId    Int      @map("supplier_id")
  branchId      Int?     @map("branch_id")
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Date
  paymentMethod String   @default("bank_transfer") @map("payment_method") @db.VarChar(50) // cheque, neft_rtgs, upi, cash, bank_transfer
  referenceNo   String?  @map("reference_no") @db.VarChar(100)
  notes         String?  @db.Text
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([supplierId], name: "idx_sp_supplier")
  @@index([paymentDate], name: "idx_sp_date")
  @@index([branchId], name: "idx_sp_branch")
  @@map("supplier_payments")
}

// Table: purchase_orders (Vendor purchase order tracking)
model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  poNumber    String    @unique @map("po_number") @db.VarChar(50)
  supplierId  Int       @map("supplier_id")
  branchId    Int?      @map("branch_id")
  poDate      DateTime  @default(now()) @map("po_date") @db.Date
  status      String    @default("pending") @db.VarChar(50) // pending, price_updated, confirmed, shipped, received, cancelled
  total       Decimal   @default(0.00) @db.Decimal(12, 2)
  notes       String?   @db.Text
  invoiceNo   String?   @map("invoice_no") @db.VarChar(100) // Supplier invoice/challan number on GRN
  paidAmount  Decimal   @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  createdBy   Int?      @map("created_by")
  shippedAt   DateTime? @map("shipped_at")
  receivedAt  DateTime? @map("received_at")
  confirmedAt DateTime? @map("confirmed_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creator  User?    @relation("POCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items    POItem[]

  @@index([poNumber], name: "idx_po_number")
  @@index([supplierId], name: "idx_po_supplier")
  @@index([status], name: "idx_po_status")
  @@index([branchId], name: "idx_po_branch")
  @@map("purchase_orders")
}

// Table: po_items (Purchase order line items)
model POItem {
  id          Int       @id @default(autoincrement())
  poId        Int       @map("po_id")
  medicineId  Int       @map("medicine_id")
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  mrp         Decimal   @db.Decimal(10, 2)
  receivedQty Int       @default(0) @map("received_qty")
  bonusQty    Int       @default(0) @map("bonus_qty")
  batchNo     String?   @map("batch_no") @db.VarChar(100)
  expiryDate  DateTime? @map("expiry_date") @db.Date
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([poId], name: "idx_po_items_po")
  @@index([medicineId], name: "idx_po_items_medicine")
  @@map("po_items")
}

// ============================================================================
// 5. CUSTOMERS & PATIENTS REGISTRY
// ============================================================================

// Table: customers (Patient & customer registry with portal accounts)
model Customer {
  id              Int       @id @default(autoincrement())
  storeId         Int?      @map("store_id")
  name            String    @db.VarChar(255)
  phone           String    @db.VarChar(50)
  email           String?   @db.VarChar(255)
  address         String?   @db.Text
  dob             DateTime? @db.Date
  gender          String?   @db.VarChar(20) // male, female, other
  medicalNotes    String?   @map("medical_notes") @db.Text
  isChronic       Boolean   @default(false) @map("is_chronic")
  chronicDiseases String?   @map("chronic_diseases") @db.VarChar(255) // e.g. "Diabetes, Hypertension"
  refillDays      Int?      @map("refill_days") // e.g. 30
  nextRefillDate  DateTime? @map("next_refill_date") @db.Date
  lastRefillDate  DateTime? @map("last_refill_date") @db.Date
  creditLimit     Decimal   @default(0.00) @map("credit_limit") @db.Decimal(10, 2)
  password        String?   @db.VarChar(255) // Optional for portal self-service
  active          Boolean   @default(true)
  verified        Boolean   @default(false)
  verifyToken     String?   @map("verify_token") @db.VarChar(100)
  verifySentAt    DateTime? @map("verify_sent_at")
  verifiedAt      DateTime? @map("verified_at")
  lastLogin       DateTime? @map("last_login")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  store           Settings?             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales           Sale[]
  returns         Return[]
  purchaseLogs    CustomerPurchaseLog[]
  patientMessages PatientMessage[]
  payments        CustomerPayment[]

  @@unique([storeId, phone], name: "uk_store_customer_phone")
  @@unique([storeId, email], name: "uk_store_customer_email")
  @@index([storeId], name: "idx_customers_store")
  @@index([phone], name: "idx_customers_phone")
  @@index([email], name: "idx_customers_email")
  @@index([isChronic], name: "idx_customers_chronic")
  @@index([nextRefillDate], name: "idx_customers_refill")
  @@map("customers")
}

// Table: customer_purchase_log (Patient purchase history summary)
model CustomerPurchaseLog {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  saleId     Int      @map("sale_id")
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @db.Date

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([customerId], name: "idx_cpl_customer")
  @@index([date], name: "idx_cpl_date")
  @@map("customer_purchase_log")
}

// Table: customer_payments (Baki Khata customer credit settlements)
model CustomerPayment {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  saleId        Int?     @map("sale_id")
  amount        Decimal  @db.Decimal(10, 2)
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Date
  paymentMethod String   @default("cash") @map("payment_method") @db.VarChar(50) // cash, upi, bank_transfer, cheque
  referenceNo   String?  @map("reference_no") @db.VarChar(100)
  notes         String?  @db.Text
  branchId      Int?     @map("branch_id")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creator  User?    @relation("CustomerPaymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([customerId], name: "idx_custpay_customer")
  @@index([paymentDate], name: "idx_custpay_date")
  @@index([branchId], name: "idx_custpay_branch")
  @@map("customer_payments")
}

// ============================================================================
// 6. POS BILLING & SALES
// ============================================================================

// Table: sales (POS invoice master)
model Sale {
  id             Int       @id @default(autoincrement())
  invoiceNo      String    @unique @map("invoice_no") @db.VarChar(50)
  customerId     Int?      @map("customer_id")
  saleDate       DateTime  @default(now()) @map("sale_date") @db.Date
  totalAmount    Decimal   @map("total_amount") @db.Decimal(12, 2)
  gstAmount      Decimal   @map("gst_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  discountId     Int?      @map("discount_id")
  grandTotal     Decimal   @map("grand_total") @db.Decimal(12, 2)
  paymentMethod  String    @default("cash") @map("payment_method") @db.VarChar(50) // cash, upi, card, cheque, credit, split
  splitDetails   String?   @map("split_details") @db.Text
  creditAmount   Decimal   @default(0.00) @map("credit_amount") @db.Decimal(12, 2)
  cardAuthCode   String?   @map("card_auth_code") @db.VarChar(100)
  cardLast4      String?   @map("card_last_4") @db.VarChar(4)
  upiRef         String?   @map("upi_ref") @db.VarChar(100)
  chequeNo       String?   @map("cheque_no") @db.VarChar(100)
  chequeBank     String?   @map("cheque_bank") @db.VarChar(100)
  chequeDate     DateTime? @map("cheque_date") @db.Date
  doctorName     String?   @map("doctor_name") @db.VarChar(255)
  doctorRegNo    String?   @map("doctor_reg_no") @db.VarChar(100)
  createdBy      Int?      @map("created_by")
  branchId       Int?      @map("branch_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creator          User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  discount         Discount?             @relation(fields: [discountId], references: [id], onDelete: SetNull)
  branch           Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items            SaleItem[]
  returns          Return[]
  purchaseLogs     CustomerPurchaseLog[]
  customerPayments CustomerPayment[]

  @@index([invoiceNo], name: "idx_sales_invoice")
  @@index([saleDate], name: "idx_sales_date")
  @@index([customerId], name: "idx_sales_customer")
  @@index([paymentMethod], name: "idx_sales_payment")
  @@index([branchId], name: "idx_sales_branch")
  @@map("sales")
}

// Table: sales_items (Invoice line items)
model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int     @map("sale_id")
  medicineId  Int     @map("medicine_id")
  batchId     Int     @map("batch_id")
  quantity    Int
  mrp         Decimal @db.Decimal(10, 2)
  taxableBase Decimal @map("taxable_base") @db.Decimal(10, 2)
  gstPercent  Decimal @map("gst_percent") @db.Decimal(5, 2)
  gstAmount   Decimal @map("gst_amount") @db.Decimal(10, 2)
  price       Decimal @db.Decimal(12, 2) // mrp * quantity

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine    Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([saleId], name: "idx_sales_items_sale")
  @@index([medicineId], name: "idx_sales_items_medicine")
  @@index([batchId], name: "idx_sales_items_batch")
  @@map("sales_items")
}

// ============================================================================
// 7. SALES RETURNS & REFUNDS
// ============================================================================

// Table: returns (Sales returns and refunds)
model Return {
  id            Int       @id @default(autoincrement())
  returnNumber  String    @unique @map("return_number") @db.VarChar(50)
  saleId        Int       @map("sale_id")
  customerId    Int?      @map("customer_id")
  branchId      Int?      @map("branch_id")
  reason        String    @db.Text
  refundAmount  Decimal   @map("refund_amount") @db.Decimal(12, 2)
  refundMethod  String    @default("cash") @map("refund_method") @db.VarChar(30) // cash, upi, store_credit
  status        String    @default("pending") @db.VarChar(50) // pending, processed, rejected
  stockAdjusted Boolean   @default(false) @map("stock_adjusted")
  requestedBy   String    @default("staff") @map("requested_by") @db.VarChar(50) // staff, customer
  createdBy     Int?      @map("created_by")
  processedAt   DateTime? @map("processed_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  sale     Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items    ReturnItem[]

  @@index([returnNumber], name: "idx_returns_number")
  @@index([saleId], name: "idx_returns_sale")
  @@index([status], name: "idx_returns_status")
  @@index([branchId], name: "idx_returns_branch")
  @@map("returns")
}

// Table: return_items (Line items of sales returns)
model ReturnItem {
  id            Int     @id @default(autoincrement())
  returnId      Int     @map("return_id")
  saleItemId    Int     @map("sale_item_id")
  medicineId    Int?    @map("medicine_id")
  batchId       Int?    @map("batch_id")
  quantity      Int
  price         Decimal @db.Decimal(12, 2)
  restockAction String  @default("restock") @map("restock_action") @db.VarChar(20) // restock, damaged_write_off

  returnReturn Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem  @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  medicine     Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  batch        Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([returnId], name: "idx_return_items_return")
  @@index([saleItemId], name: "idx_return_items_sale_item")
  @@map("return_items")
}

// ============================================================================
// 8. DISCOUNTS & PROMOTIONS
// ============================================================================

// Table: discounts (Discount policies and promotional schemes)
model Discount {
  id        Int      @id @default(autoincrement())
  storeId   Int?     @map("store_id")
  name      String   @db.VarChar(255)
  type      String   @default("percent") @db.VarChar(20) // percent, flat
  value     Decimal  @db.Decimal(10, 2)
  minAmount Decimal  @default(0.00) @map("min_amount") @db.Decimal(10, 2)
  active    Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  store Settings? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([storeId], name: "idx_discounts_store")
  @@map("discounts")
}

// ============================================================================
// 9. AUDIT LOGS, STOCK ADJUSTMENTS & SECURITY RATE LIMITING
// ============================================================================

// Table: stock_adjustments (Permanent inventory adjustment and audit trail)
model StockAdjustment {
  id         Int      @id @default(autoincrement())
  batchId    Int      @map("batch_id")
  medicineId Int      @map("medicine_id")
  branchId   Int?     @map("branch_id")
  type       String   @db.VarChar(20) // add, remove, sale, return, transfer
  quantity   Int
  reason     String   @db.VarChar(255)
  oldQty     Int      @map("old_qty")
  newQty     Int      @map("new_qty")
  userId     Int?     @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([batchId], name: "idx_adj_batch")
  @@index([medicineId], name: "idx_adj_medicine")
  @@index([branchId], name: "idx_adj_branch")
  @@index([createdAt], name: "idx_adj_created")
  @@map("stock_adjustments")
}

// Table: login_attempts (Security brute-force rate limiter)
model LoginAttempt {
  id      Int      @id @default(autoincrement())
  ip      String   @db.VarChar(45)
  context String   @db.VarChar(50) // admin, supplier, customer
  ts      DateTime @default(now())

  @@index([ip, context], name: "idx_login_attempts_ip_context")
  @@map("login_attempts")
}

// Table: audit_logs (System-wide tamper-proof activity audit trail scoped by Store Tenant)
model AuditLog {
  id        Int      @id @default(autoincrement())
  storeId   Int?     @map("store_id")
  userId    Int?     @map("user_id")
  branchId  Int?     @map("branch_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  details   String?  @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  store  Settings? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([storeId], name: "idx_audit_logs_store")
  @@index([action], name: "idx_audit_logs_action")
  @@index([entity], name: "idx_audit_logs_entity")
  @@index([branchId], name: "idx_audit_logs_branch")
  @@index([createdAt], name: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

// ============================================================================
// 10. COMMUNICATION INBOXES & PRESCRIPTION FILES
// ============================================================================

// Table: supplier_messages (Supplier extranet messaging channel)
model SupplierMessage {
  id           Int       @id @default(autoincrement())
  storeId      Int?      @map("store_id")
  supplierId   Int?      @map("supplier_id")
  supplierName String?   @map("supplier_name") @db.VarChar(255)
  senderEmail  String?   @map("sender_email") @db.VarChar(255)
  subject      String    @db.VarChar(255)
  message      String    @db.Text
  direction    String    @default("in") @db.VarChar(10) // in, out
  reply        String?   @db.Text
  repliedAt    DateTime? @map("replied_at")
  status       String    @default("unread") @db.VarChar(20) // unread, read, replied
  createdAt    DateTime  @default(now()) @map("created_at")

  store    Settings? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([storeId], name: "idx_sm_store")
  @@index([supplierId], name: "idx_sm_supplier")
  @@index([status], name: "idx_sm_status")
  @@map("supplier_messages")
}

// Table: patient_messages (Customer prescription uploads and inquiries)
model PatientMessage {
  id         Int      @id @default(autoincrement())
  storeId    Int?     @map("store_id")
  branchId   Int?     @map("branch_id")
  customerId Int      @map("customer_id")
  direction  String   @default("in") @db.VarChar(10) // in, out
  message    String?  @db.Text
  filePath   String?  @map("file_path") @db.VarChar(500)
  fileName   String?  @map("file_name") @db.VarChar(255)
  fileType   String?  @map("file_type") @db.VarChar(50)
  isRead     Boolean  @default(false) @map("is_read")
  createdBy  Int?     @map("created_by") // Admin user ID if direction=out
  createdAt  DateTime @default(now()) @map("created_at")

  store    Settings? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([storeId], name: "idx_pm_store")
  @@index([branchId], name: "idx_pm_branch")
  @@index([customerId], name: "idx_pm_customer")
  @@index([isRead], name: "idx_pm_is_read")
  @@map("patient_messages")
}

// ============================================================================
// 11. FINANCIAL LEDGERS, EXPENSES & CASH DRAWER CLOSING (MODULE 2.12 & 2.13)
// ============================================================================

// Table: expenses (Operational overheads, store expenses and non-sale revenues)
model Expense {
  id           Int      @id @default(autoincrement())
  voucherNo    String   @unique @map("voucher_no") @db.VarChar(50) // e.g. EXP-2026-00001
  storeId      Int?     @map("store_id")
  branchId     Int?     @map("branch_id")
  userId       Int?     @map("user_id") // Cashier or admin recording the voucher
  type         String   @default("expense") @db.VarChar(20) // expense, income
  category     String   @db.VarChar(100) // Electricity, Rent, Salary, Tea, Maintenance, etc.
  title        String   @db.VarChar(255)
  amount       Decimal  @db.Decimal(12, 2)
  paymentMode  String   @default("cash") @map("payment_mode") @db.VarChar(50) // cash, upi, bank_transfer, card, cheque
  referenceNo  String?  @map("reference_no") @db.VarChar(100) // Bill no / UTR / Cheque
  payeeOrPayer String?  @map("payee_or_payer") @db.VarChar(255) // Vendor or person name
  notes        String?  @db.Text
  expenseDate  DateTime @default(now()) @map("expense_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  store  Settings? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId], name: "idx_expenses_store")
  @@index([branchId], name: "idx_expenses_branch")
  @@index([type], name: "idx_expenses_type")
  @@index([category], name: "idx_expenses_category")
  @@index([expenseDate], name: "idx_expenses_date")
  @@map("expenses")
}

// Table: cash_drawer_closings (End-of-shift & day-end register reconciliation / Z-Report)
model CashDrawerClosing {
  id              Int      @id @default(autoincrement())
  closingNumber   String   @unique @map("closing_number") @db.VarChar(50) // e.g. ZREP-2026-00001
  storeId         Int?     @map("store_id")
  branchId        Int?     @map("branch_id")
  userId          Int?     @map("user_id") // Cashier who closed the shift
  shiftStart      DateTime @map("shift_start")
  shiftEnd        DateTime @map("shift_end")
  openingFloat    Decimal  @default(0.00) @map("opening_float") @db.Decimal(12, 2)
  cashSales       Decimal  @default(0.00) @map("cash_sales") @db.Decimal(12, 2)
  cashReturns     Decimal  @default(0.00) @map("cash_returns") @db.Decimal(12, 2)
  cashExpenses    Decimal  @default(0.00) @map("cash_expenses") @db.Decimal(12, 2)
  cashIncomes     Decimal  @default(0.00) @map("cash_incomes") @db.Decimal(12, 2)
  expectedCash    Decimal  @map("expected_cash") @db.Decimal(12, 2) // openingFloat + cashSales - cashReturns - cashExpenses + cashIncomes
  countedCash     Decimal  @map("counted_cash") @db.Decimal(12, 2)
  difference      Decimal  @map("difference") @db.Decimal(12, 2) // countedCash - expectedCash
  status          String   @default("exact") @db.VarChar(20) // exact, excess, shortage
  denominations   String   @db.Text // JSON string: { "2000": 0, "500": 10, ... }
  totalSalesCount Int      @default(0) @map("total_sales_count")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  store  Settings? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId], name: "idx_cash_closings_store")
  @@index([branchId], name: "idx_cash_closings_branch")
  @@index([shiftEnd], name: "idx_cash_closings_shift_end")
  @@map("cash_drawer_closings")
}

// ============================================================================
// 12. SAAS PLATFORM CEO / SUPER ADMIN, SUBSCRIPTIONS & RAZORPAY BILLING (PART 3)
// ============================================================================

// Table: platform_users (Platform CEO / Super Admin / Finance / Support accounts — strictly isolated from store users)
model PlatformUser {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  username  String    @unique @db.VarChar(100)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      String    @default("platform_admin") @db.VarChar(50) // ceo, platform_admin, finance_ops, support_viewer
  active    Boolean   @default(true)
  lastLogin DateTime? @map("last_login")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  grantedSubscriptions StoreSubscription[]  @relation("SubscriptionGrantor")
  platformAuditLogs    PlatformAuditLog[]
  announcements        PlatformAnnouncement[]

  @@index([role], name: "idx_pu_role")
  @@index([active], name: "idx_pu_active")
  @@map("platform_users")
}

// Table: platform_config (Platform billing, GST, trial/grace policy & encrypted Razorpay settings)
model PlatformConfig {
  id                       Int      @id @default(autoincrement())
  platformName             String   @default("Medical POS Cloud") @map("platform_name") @db.VarChar(255)
  legalEntityName          String?  @map("legal_entity_name") @db.VarChar(255)
  gstNo                    String?  @map("gst_no") @db.VarChar(50)
  sacCode                  String   @default("998314") @map("sac_code") @db.VarChar(20)
  billingAddress           String?  @map("billing_address") @db.Text
  supportEmail             String?  @map("support_email") @db.VarChar(255)
  supportPhone             String?  @map("support_phone") @db.VarChar(50)
  defaultTrialDays         Int      @default(14) @map("default_trial_days")
  gracePeriodDays          Int      @default(7) @map("grace_period_days")
  razorpayMode             String   @default("test") @map("razorpay_mode") @db.VarChar(20) // test, live
  razorpayKeyId            String?  @map("razorpay_key_id") @db.VarChar(255)
  razorpayKeySecretEnc     String?  @map("razorpay_key_secret_enc") @db.Text
  razorpayWebhookSecretEnc String?  @map("razorpay_webhook_secret_enc") @db.Text
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@map("platform_config")
}

// Table: platform_audit_logs (Platform-wide CEO / Super Admin audit log trail)
model PlatformAuditLog {
  id             Int      @id @default(autoincrement())
  platformUserId Int?     @map("platform_user_id")
  storeId        Int?     @map("store_id")
  action         String   @db.VarChar(100)
  entity         String   @db.VarChar(100)
  entityId       Int?     @map("entity_id")
  details        String?  @db.Text
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([platformUserId], name: "idx_pal_user")
  @@index([storeId], name: "idx_pal_store")
  @@index([action], name: "idx_pal_action")
  @@index([entity], name: "idx_pal_entity")
  @@index([createdAt], name: "idx_pal_created_at")
  @@map("platform_audit_logs")
}

// Table: platform_announcements (Broadcast alerts pushed by Super Admin to Store Admin notification bells)
model PlatformAnnouncement {
  id             Int       @id @default(autoincrement())
  platformUserId Int?      @map("platform_user_id")
  title          String    @db.VarChar(255)
  message        String    @db.Text
  severity       String    @default("info") @db.VarChar(20) // info, warning, urgent
  targetPlanCode String?   @map("target_plan_code") @db.VarChar(60)
  targetStoreId  Int?      @map("target_store_id")
  active         Boolean   @default(true)
  expiresAt      DateTime? @map("expires_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  author PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([active], name: "idx_pa_active")
  @@index([targetStoreId], name: "idx_pa_store")
  @@map("platform_announcements")
}

// Table: subscription_plans (SaaS subscription tiers, quotas, feature flags & Razorpay Plan sync)
model SubscriptionPlan {
  id                 Int       @id @default(autoincrement())
  code               String    @unique @db.VarChar(60) // e.g. FREE_TRIAL, STARTER_MONTHLY, GROWTH_MONTHLY, ENTERPRISE_MONTHLY
  name               String    @db.VarChar(120)
  tagline            String?   @db.VarChar(255)
  description        String?   @db.Text
  billingCycle       String    @default("monthly") @map("billing_cycle") @db.VarChar(20) // monthly, quarterly, yearly, lifetime
  intervalCount      Int       @default(1) @map("interval_count")
  priceInr           Decimal   @default(0.00) @map("price_inr") @db.Decimal(10, 2)
  setupFeeInr        Decimal   @default(0.00) @map("setup_fee_inr") @db.Decimal(10, 2)
  trialDays          Int       @default(0) @map("trial_days")
  isPublic           Boolean   @default(true) @map("is_public")
  isRecommended      Boolean   @default(false) @map("is_recommended")
  isActive           Boolean   @default(true) @map("is_active")
  sortOrder          Int       @default(0) @map("sort_order")
  razorpayPlanId     String?   @unique @map("razorpay_plan_id") @db.VarChar(100)
  razorpaySyncedAt   DateTime? @map("razorpay_synced_at")
  razorpaySyncStatus String    @default("pending") @map("razorpay_sync_status") @db.VarChar(20) // pending, synced, failed, not_applicable
  razorpaySyncError  String?   @map("razorpay_sync_error") @db.Text
  maxBranches        Int       @default(1) @map("max_branches") // -1 = Unlimited
  maxStaffUsers      Int       @default(3) @map("max_staff_users")
  maxMedicines       Int       @default(2000) @map("max_medicines")
  maxMonthlyInvoices Int       @default(1000) @map("max_monthly_invoices")
  maxSuppliers       Int       @default(25) @map("max_suppliers")
  maxRxStorageMb     Int       @default(250) @map("max_rx_storage_mb")
  maxCustomers       Int       @default(-1) @map("max_customers")
  maxDiscountSchemes Int       @default(5) @map("max_discount_schemes")
  featuresJson       String    @map("features_json") @db.Text
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  subscriptions StoreSubscription[]
  payments      SubscriptionPayment[]

  @@index([isActive], name: "idx_sp_active")
  @@index([isPublic], name: "idx_sp_public")
  @@index([billingCycle], name: "idx_sp_cycle")
  @@index([sortOrder], name: "idx_sp_sort")
  @@map("subscription_plans")
}

// Table: store_subscriptions (Active/historical SaaS subscription state per Store Tenant)
model StoreSubscription {
  id                      Int       @id @default(autoincrement())
  storeId                 Int       @map("store_id")
  planId                  Int       @map("plan_id")
  status                  String    @default("trialing") @db.VarChar(30) // trialing, active, past_due, grace_period, cancelled, expired, suspended
  billingMode             String    @default("manual_grant") @map("billing_mode") @db.VarChar(30) // razorpay_subscription, razorpay_order, manual_grant
  razorpaySubscriptionId  String?   @unique @map("razorpay_subscription_id") @db.VarChar(100)
  razorpayCustomerId      String?   @map("razorpay_customer_id") @db.VarChar(100)
  currentPeriodStart      DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd        DateTime  @map("current_period_end")
  trialEndsAt             DateTime? @map("trial_ends_at")
  graceEndsAt             DateTime? @map("grace_ends_at")
  cancelAtPeriodEnd       Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt             DateTime? @map("cancelled_at")
  autoRenew               Boolean   @default(true) @map("auto_renew")
  customLimitsJson        String?   @map("custom_limits_json") @db.Text
  customFeaturesJson      String?   @map("custom_features_json") @db.Text
  grantedByPlatformUserId Int?      @map("granted_by_platform_user_id")
  notes                   String?   @db.Text
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  store     Settings              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  grantedBy PlatformUser?         @relation("SubscriptionGrantor", fields: [grantedByPlatformUserId], references: [id], onDelete: SetNull)
  payments  SubscriptionPayment[]

  @@index([storeId], name: "idx_ss_store")
  @@index([planId], name: "idx_ss_plan")
  @@index([status], name: "idx_ss_status")
  @@index([currentPeriodEnd], name: "idx_ss_period_end")
  @@map("store_subscriptions")
}

// Table: subscription_payments (Immutable Razorpay / offline SaaS payments and GST invoices)
model SubscriptionPayment {
  id                        Int       @id @default(autoincrement())
  subscriptionId            Int?      @map("subscription_id")
  storeId                   Int       @map("store_id")
  planId                    Int       @map("plan_id")
  invoiceNo                 String    @unique @map("invoice_no") @db.VarChar(60) // e.g. SUB-INV-2026-00001
  amountSubtotal            Decimal   @map("amount_subtotal") @db.Decimal(12, 2)
  gstPercent                Decimal   @default(18.00) @map("gst_percent") @db.Decimal(5, 2)
  gstAmount                 Decimal   @map("gst_amount") @db.Decimal(12, 2)
  totalAmount               Decimal   @map("total_amount") @db.Decimal(12, 2)
  currency                  String    @default("INR") @db.VarChar(10)
  paymentType               String    @default("initial") @map("payment_type") @db.VarChar(30) // initial, renewal, upgrade_proration, manual_offline
  status                    String    @default("created") @db.VarChar(30) // created, authorized, captured, failed, refunded
  razorpayOrderId           String?   @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId         String?   @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySubscriptionId    String?   @map("razorpay_subscription_id") @db.VarChar(100)
  razorpaySignatureVerified Boolean   @default(false) @map("razorpay_signature_verified")
  paymentMethod             String?   @map("payment_method") @db.VarChar(50)
  paidAt                    DateTime? @map("paid_at")
  failureReason             String?   @map("failure_reason") @db.Text
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  subscription StoreSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  store        Settings           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([storeId], name: "idx_subpay_store")
  @@index([subscriptionId], name: "idx_subpay_sub")
  @@index([planId], name: "idx_subpay_plan")
  @@index([status], name: "idx_subpay_status")
  @@index([paidAt], name: "idx_subpay_paid_at")
  @@index([razorpayOrderId], name: "idx_subpay_rzp_order")
  @@map("subscription_payments")
}

// Table: razorpay_webhook_events (Idempotency and replay-protection ledger for Razorpay webhooks)
model RazorpayWebhookEvent {
  id                Int       @id @default(autoincrement())
  eventId           String    @unique @map("event_id") @db.VarChar(150) // x-razorpay-event-id
  eventType         String    @map("event_type") @db.VarChar(100)
  payloadJson       String    @map("payload_json") @db.Text
  signatureVerified Boolean   @default(false) @map("signature_verified")
  processed         Boolean   @default(false)
  processedAt       DateTime? @map("processed_at")
  errorMessage      String?   @map("error_message") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([eventType], name: "idx_rzp_ev_type")
  @@index([processed], name: "idx_rzp_ev_processed")
  @@index([createdAt], name: "idx_rzp_ev_created")
  @@map("razorpay_webhook_events")
}

// ============================================================================
// 13. UNIVERSAL EMAIL OTP PASSWORD RESET TOKENS (ALL 4 PANELS)
// ============================================================================

// Table: password_reset_otps (Single-use 6-digit Email OTP reset requests for Admin, Super Admin, Customer, Supplier)
model PasswordResetOtp {
  id           Int       @id @default(autoincrement())
  panel        String    @db.VarChar(30) // admin, super_admin, customer, supplier
  targetUserId Int       @map("target_user_id")
  email        String    @db.VarChar(255)
  otpHash      String    @map("otp_hash") @db.VarChar(128)
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([panel, targetUserId], name: "idx_pwd_otp_target")
  @@index([panel, email], name: "idx_pwd_otp_email")
  @@index([expiresAt], name: "idx_pwd_otp_exp")
  @@map("password_reset_otps")
}
